     icount_warp_rt();
 }
 
+bool icount_rr_slice_in_flight;
+
 void icount_start_warp_timer(void)
 {
     int64_t clock;
@@ -295,6 +297,17 @@ void icount_start_warp_timer(void)
 
     assert(icount_enabled());
 
+    /*
+     * TBI: with sleep=off the warp adds (next deadline - now) to the bias. While a round-robin
+     * slice is in flight, a caller outside the vCPU thread (e.g. the main loop) reads a "now"
+     * that excludes the slice's executed-but-unaccounted instructions, so the warp overshoots
+     * by a host-timing-dependent amount. Defer: once the slice is accounted and all CPUs are
+     * idle, the rr thread notifies the main loop, which warps from an exact clock.
+     */
+    if (!icount_sleep && icount_rr_slice_in_flight) {
+        return;
+    }
+
     /*
      * Nothing to do if the VM is stopped: QEMU_CLOCK_VIRTUAL timers
      * do not fire, so computing the deadline does not make sense.
