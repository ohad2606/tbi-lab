+static void tbi_request_pause(TbiGpioBridge *s)
+{
+    if (!s->sync) {
+        return;
+    }
+    s->unacked++;
+    /* Safe from vCPU context: the stop takes effect at the end of the current TB. */
+    qemu_system_vmstop_request_prepare();
+    qemu_system_vmstop_request(RUN_STATE_PAUSED);
+}
+
+static void tbi_resume_bh(void *opaque)
+{
+    TbiGpioBridge *s = TBI_GPIO_BRIDGE(opaque);
+
+    if (s->unacked == 0 && runstate_check(RUN_STATE_PAUSED)) {
+        vm_start();
+    }
+}
+
+/*
+ * The host may acknowledge an event before the requested stop has taken effect. Whichever
+ * happens last -- the final "C", or the transition to PAUSED -- triggers the resume.
+ */
+static void tbi_vm_state_change(void *opaque, bool running, RunState state)
+{
+    TbiGpioBridge *s = TBI_GPIO_BRIDGE(opaque);
+
+    if (!running && state == RUN_STATE_PAUSED && s->unacked == 0) {
+        qemu_bh_schedule(s->resume_bh);
+    }
+}
+
+static void tbi_sock_write(TbiGpioBridge *s, const char *line)
+{
+    size_t n = strlen(line), off = 0;
+    while (off < n) {
+        ssize_t w = send(s->sfd, line + off, n - off, 0);
+        if (w <= 0) {
+            error_report("tbi-gpio-bridge: syncsock write failed");
+            exit(1);
+        }
+        off += w;
+    }
+}
+
+/* Blocking read of one line from the private socket. */
+static void tbi_sock_readline(TbiGpioBridge *s, char *out, size_t cap)
+{
+    for (;;) {
+        char *nl = memchr(s->sbuf, '\n', s->slen);
+        if (nl) {
+            size_t len = nl - s->sbuf;
+            if (len >= cap) {
+                len = cap - 1;
+            }
+            memcpy(out, s->sbuf, len);
+            out[len] = '\0';
+            memmove(s->sbuf, nl + 1, s->slen - (nl + 1 - s->sbuf));
+            s->slen -= (nl + 1 - s->sbuf);
+            return;
+        }
+        ssize_t r = recv(s->sfd, s->sbuf + s->slen, sizeof(s->sbuf) - s->slen, 0);
+        if (r <= 0) {
+            error_report("tbi-gpio-bridge: syncsock host disconnected");
+            exit(1);
+        }
+        s->slen += r;
+    }
+}
+
+/* Send one event line, then serve host commands until "C". Caller holds the BQL. */
+static void tbi_sync_exchange(TbiGpioBridge *s, const char *event)
+{
+    char line[128];
+    int pin, level;
+
+    tbi_sock_write(s, event);
+    for (;;) {
+        tbi_sock_readline(s, line, sizeof(line));
+        if (line[0] == 'C' && line[1] == '\0') {
+            return;
+        }
+        if (sscanf(line, "I %d %d", &pin, &level) == 2 &&
+            pin >= 0 && pin < TBI_IN_PINS && s->in_lines[pin]) {
+            char ack[96];
+            qemu_set_irq(s->in_lines[pin], level ? 1 : 0);
+            snprintf(ack, sizeof(ack), "A %d %d %" PRId64 "\n", pin, level ? 1 : 0,
+                     qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+            tbi_sock_write(s, ack);
+        }
+    }
+}
+
+static bool tbi_sync_event(TbiGpioBridge *s, char kind, int pin, int level)
+{
+    char ev[96];
+
+    if (!s->syncport) {
+        return false;
+    }
+    snprintf(ev, sizeof(ev), "%c %d %d %" PRId64 "\n", kind, pin, level,
+             qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    tbi_sync_exchange(s, ev);
+    return true;
+}
+
+static void tbi_poll_cb(void *opaque)
+{
+    TbiGpioBridge *s = TBI_GPIO_BRIDGE(opaque);
+    char ev[128];
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    {
+        /* Diagnostic: append each vCPU's PC and halted state, to localise divergence. */
+        CPUState *cpu;
+        int off = snprintf(ev, sizeof(ev), "T %" PRId64, now);
+        CPU_FOREACH(cpu) {
+            CPUClass *cc = CPU_GET_CLASS(cpu);
+            if (off < (int)sizeof(ev) - 24) {
+                off += snprintf(ev + off, sizeof(ev) - off, " %08" PRIx64 ":%d",
+                                (uint64_t)cc->get_pc(cpu), cpu->halted);
+            }
+        }
+        snprintf(ev + off, sizeof(ev) - off, "\n");
+    }
+    tbi_sync_exchange(s, ev);
+    timer_mod(s->poll_timer, now + (int64_t)s->poll_us * 1000);
+}
+
+static void tbi_keepalive_cb(void *opaque)
+{
+    TbiGpioBridge *s = TBI_GPIO_BRIDGE(opaque);
+    timer_mod(s->keepalive_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + (int64_t)s->keepalive_us * 1000);
+}
+
+/* Arm the wait BEFORE emitting, so a fast host reply cannot be lost. */
+static bool tbi_inline_arm(TbiGpioBridge *s)
+{
+    if (!s->inline_sync || !current_cpu) {
+        return false;          /* only block vCPU threads, never the main loop */
+    }
+    qemu_mutex_lock(&s->lock);
+    s->waiting = true;
+    s->reply_ready = false;
+    s->pend_n = 0;
+    qemu_mutex_unlock(&s->lock);
+    return true;
+}
+
+static void tbi_inline_wait(TbiGpioBridge *s)
+{
+    int n;
+    int pins[2 * TBI_IN_PINS];
+    int levels[2 * TBI_IN_PINS];
+
+    bql_unlock();
+    qemu_mutex_lock(&s->lock);
+    while (!s->reply_ready) {
+        qemu_cond_wait(&s->cond, &s->lock);
+    }
+    n = s->pend_n;
+    memcpy(pins, s->pend_pin, sizeof(int) * n);
+    memcpy(levels, s->pend_level, sizeof(int) * n);
+    s->pend_n = 0;
+    s->waiting = false;
+    qemu_mutex_unlock(&s->lock);
+    bql_lock();
+
+    for (int i = 0; i < n; i++) {
+        qemu_set_irq(s->in_lines[pins[i]], levels[i]);
+        if (s->vclock) {
+            tbi_emit(s, 'A', pins[i], levels[i]);
+        }
+    }
+}
