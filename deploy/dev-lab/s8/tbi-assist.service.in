# Sprint 28: the AI provider service (runtime/assist). Rendered by install.sh. INACTIVE.
#
# Reached only through its unix socket (mode 0660, group @U@assist; on dev-lab only Caddy, the
# internal reverse proxy, is a member). It is NOT in the gate group: it cannot reach the build
# service's or the Session Host's sockets, and those paths, the artifact store and the build
# state are inaccessible to it. It never starts or signals anything.
#
# No network: RestrictAddressFamilies=AF_UNIX and IPAddressDeny=any. While inactive it cannot
# reach any provider whatever its configuration says. Activation (owner-approved, see
# docs/sprints/SPRINT-28.md) is a separate drop-in that adds the provider key as a credential
# (LoadCredential=provider-key:...) and allows egress to the provider only; nothing here does.
[Unit]
Description=TBI Lab AI provider service (@N@, inactive unless owner-approved)
After=network-online.target

[Service]
User=@U@assist
Group=@U@assist
UMask=0007
Environment=TBI_ASSIST_LISTEN=unix:/run/@N@-assist/api.sock
Environment=TBI_SOCKET_GID=@ASSIST_GID@
Environment=TBI_ASSIST_STATE=/var/lib/@N@-assist
Environment=TBI_ASSIST_ALLOW_MOCK=@ASSIST_ALLOW_MOCK@
Environment=TBI_IDENTITY_KEY_FILE=%d/identity.key
LoadCredential=identity.key:/etc/@N@/identity.key
LoadCredential=assist.json:/etc/@N@/assist.json
Environment=TBI_ASSIST_CONFIG=%d/assist.json
RuntimeDirectory=@N@-assist
RuntimeDirectoryMode=0755
StateDirectory=@N@-assist
StateDirectoryMode=0700
BindReadOnlyPaths=@NODE@:/opt/tbi-node
BindReadOnlyPaths=@BUNDLES@:/opt/tbi-build
InaccessiblePaths=-/run/@N@-build -/run/@N@-runtime -/run/tbi-gate -/var/lib/@N@-build -@STORE@ -/srv/tbi-lab -/home
ExecStart=/opt/tbi-node/bin/node /opt/tbi-build/assist-service.mjs
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=10

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
