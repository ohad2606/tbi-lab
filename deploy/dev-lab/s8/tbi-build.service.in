# Sprint 8: the build service (identity, ownership, sandboxed builds). Rendered by install.sh.
#
# Reached only through its unix socket (mode 0660, group tbi-gate: the internal reverse proxy).
# It never runs a compiler itself: each tool step is an instance of @N@-build-job@.service,
# which it may only start/stop/kill (polkit). Keys come in as systemd credentials (root-only
# files, never readable by the job sandboxes).
[Unit]
Description=TBI Lab build service (@N@)
After=network-online.target

[Service]
User=@U@build
Group=@U@buildio
SupplementaryGroups=@U@artifacts tbi-gate
UMask=0007
Environment=TBI_BUILD_LISTEN=unix:/run/@N@-build/api.sock
Environment=TBI_SOCKET_GID=@GATE_GID@
Environment=TBI_ARDUINO_HOME=/opt/tbi-arduino
Environment=TBI_MICROPYTHON_HOME=/opt/tbi-micropython
Environment=TBI_ARTIFACT_STORE=@STORE@
Environment=TBI_BUILD_WORK=/var/lib/@N@-build/jobs
Environment=TBI_BUILD_STATE=/var/lib/@N@-build/state
Environment=TBI_BUILD_JOB_UNIT=@N@-build-job
Environment=TBI_ARTIFACT_CAP_MB=@ARTIFACT_CAP_MB@
Environment=TBI_ARTIFACT_LEASE_MS=600000
Environment=TBI_IDENTITY_KEY_FILE=%d/identity.key
Environment=TBI_TICKET_KEY_FILE=%d/ticket.key
LoadCredential=identity.key:/etc/@N@/identity.key
LoadCredential=ticket.key:/etc/@N@/ticket.key
# Phase 4: plans, quotas and global limits; the Session Host's live sessions defer new builds.
LoadCredential=policy.json:/etc/@N@/policy.json
Environment=TBI_POLICY_FILE=%d/policy.json
# Sprint 12 (ADR-011 §5): the instance's runtime.json (install.sh / switch-runtime.sh copy it from
# the runtime prefix the QEMU units bind): its `capabilities` decide `requires` vs `unsupported`.
LoadCredential=runtime.json:/etc/@N@/runtime.json
Environment=TBI_RUNTIME_JSON=%d/runtime.json
Environment=TBI_RUNTIME_HEALTH=unix:/run/@N@-runtime/api.sock
RuntimeDirectory=@N@-build
RuntimeDirectoryMode=0755
StateDirectory=@N@-build/jobs @N@-build/state
StateDirectoryMode=0750
BindReadOnlyPaths=@ARDUINO@:/opt/tbi-arduino
# Sprint 19B: the MicroPython build home (optional: absent, the profile is not offered).
BindReadOnlyPaths=-@MICROPYTHON@:/opt/tbi-micropython
BindReadOnlyPaths=@NODE@:/opt/tbi-node
BindReadOnlyPaths=@BUNDLES@:/opt/tbi-build
ReadWritePaths=@STORE@
ExecStart=/opt/tbi-node/bin/node /opt/tbi-build/build-service.mjs
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=20

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
# Unix sockets only (its API socket, D-Bus to start job units): no network at all.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
