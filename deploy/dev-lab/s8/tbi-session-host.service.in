# Sprint 8: the R2 Session Host as its own non-login user (D-S8-7). Rendered by install.sh.
#
# It never runs QEMU itself: each session's runtime is an instance of @N@-qemu@.service, which it
# may only start/stop/kill (polkit). Sessions live on disk under /var/lib/@N@-runtime/sessions
# (not the RAM-backed /tmp). Reached only through its unix socket, group tbi-sock-runtime: only this
# service and the internal reverse proxy (caddy) are in it (Sprint 23B, security review H1: the
# backends no longer share tbi-gate, so the build service cannot reach this socket). The build
# service's admission check reads a separate GET /health-only socket (group tbi-artifacts).
[Unit]
Description=TBI Lab Session Host (@N@)
After=network-online.target

[Service]
User=tbi-runtime
Group=tbi-runtimeio
SupplementaryGroups=tbi-artifacts tbi-sock-runtime
UMask=0007
Environment=TBI_HOST_LISTEN=unix:/run/@N@-runtime/api.sock
Environment=TBI_SOCKET_GID=@SOCK_RUNTIME_GID@
Environment=TBI_HOST_HEALTH_LISTEN=unix:/run/@N@-runtime/health.sock
Environment=TBI_HOST_HEALTH_SOCKET_GID=@ARTIFACTS_GID@
Environment=TBI_ARTIFACTS=@STORE@
Environment=TBI_QEMU=/opt/tbi-runtime/bin/qemu-system-xtensa
Environment=TBI_HOST_SESSION_ROOT=/var/lib/@N@-runtime/sessions
Environment=TBI_HOST_RUNTIME_UNIT=@N@-qemu
Environment=TBI_IDENTITY_KEY_FILE=%d/identity.key
Environment=TBI_TICKET_KEY_FILE=%d/ticket.key
LoadCredential=identity.key:/etc/@N@/identity.key
LoadCredential=ticket.key:/etc/@N@/ticket.key
# Phase 4: plans, quotas and global limits; session-creation rates survive a restart.
LoadCredential=policy.json:/etc/@N@/policy.json
Environment=TBI_POLICY_FILE=%d/policy.json
Environment=TBI_HOST_STATE=/var/lib/@N@-runtime/state
# Sprint 14 in-app problem reports (docs/alpha/PROBLEM-REPORTS.md): OFF while unset (the endpoint
# answers 503). The host creates the directory 0700 inside its own state directory, which is
# already writable; no other sandbox change is needed. Enable together with an app build made
# with VITE_PROBLEM_REPORTS=1.
#Environment=TBI_REPORTS_DIR=/var/lib/@N@-runtime/state/reports
# Sprint 23B access enforcement, revocation and owner administration (docs/alpha/
# ADMIN-AND-FEEDBACK.md): OFF while unset (RC4 behaviour). The root helper's installer creates
# /var/lib/tbi-admin; the host only writes requests and identity observations there and reads
# the views and results. Enabled by install.sh TBI_S23_ADMIN=1 (or uncomment all three).
# Groups (the helper's installer creates them): tbi-admin-view reads the views, tbi-admin-spool
# writes requests and observations and reads results. Added to the user's own groups (a list
# setting: this line extends SupplementaryGroups above).
#SupplementaryGroups=tbi-admin-view tbi-admin-spool
#Environment=TBI_ACCESS_VIEW=/var/lib/tbi-admin/view/access.json
#Environment=TBI_ADMIN_DIR=/var/lib/tbi-admin
#ReadOnlyPaths=-/var/lib/tbi-admin/view -/var/lib/tbi-admin/results
#ReadWritePaths=-/var/lib/tbi-admin/spool -/var/lib/tbi-admin/observations
# Live-session ceiling of this host (install.sh TBI_S8_HOST_MAX_SESSIONS, at least the policy's limit).
Environment=TBI_HOST_MAX_SESSIONS=@HOST_MAX_SESSIONS@
RuntimeDirectory=@N@-runtime
RuntimeDirectoryMode=0755
StateDirectory=@N@-runtime/sessions @N@-runtime/state
StateDirectoryMode=0770
BindReadOnlyPaths=@NODE@:/opt/tbi-node
BindReadOnlyPaths=@BUNDLES@:/opt/tbi-build
ReadOnlyPaths=@STORE@
ExecStart=/opt/tbi-node/bin/node /opt/tbi-build/session-host.mjs
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
# SIGTERM to the host only: it ends its sessions in order (each runtime unit stops, records its
# exit, then the session directory goes). Anything left gets SIGKILL after the timeout.
KillMode=mixed
TimeoutStopSec=20

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
