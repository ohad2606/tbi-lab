# Sprint 10 preview: an isolated, experimental static build of the `sprint-10` branch at
# https://dev-lab.tbi-tech.net/s10-preview/ — imported into the internal origin of
# /etc/caddy/Caddyfile (the `http://` site behind oauth2-proxy) by install-route.sh, so it sits
# behind exactly the same Google login and allowlist as dev-lab itself.
#
# Its own web root (/srv/tbi-lab/s10-preview/current); dev-lab's root, releases and services are
# never touched. Sprint 10 is frontend-only: the preview app calls the existing same-origin
# /runtime and /build endpoints of the validated Sprint 8 backends, unchanged. Its projects and
# preferences are kept apart in the browser (VITE_STORAGE_NAMESPACE, see publish.sh).
#
# Installed as /etc/caddy/tbi-s10-preview.caddy. No secrets here.

redir /s10-preview /s10-preview/ 308

handle_path /s10-preview/* {
	root * /srv/tbi-lab/s10-preview/current

	# Hashed build assets, as for dev-lab: cached privately; a missing asset is a 404.
	@s10assets path /assets/*
	handle @s10assets {
		header Cache-Control "private, max-age=31536000, immutable"
		file_server
	}

	# The HTML entry point is never cached, so the preview cannot load without the gate.
	handle {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		try_files {path} /index.html
		file_server
	}
}
