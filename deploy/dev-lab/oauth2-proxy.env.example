# Template for /etc/oauth2-proxy/oauth2-proxy.env (owner root, mode 0600). Never commit the
# real file. The cookie secret is generated on the server:
#   openssl rand -base64 32 | tr -- '+/' '-_' | tr -d '='
OAUTH2_PROXY_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
OAUTH2_PROXY_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
OAUTH2_PROXY_COOKIE_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
