{
  "name": "tbi-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TBI Lab. Production code lives in app/ and packages/; experiments/ is frozen Sprint 0/1 evidence.",
  "scripts": {
    "dev": "npm run dev --workspace @tbi-lab/app",
    "build": "npm run build --workspace @tbi-lab/app",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.specs.json && tsc --noEmit -p packages/domain && tsc --noEmit -p packages/engine && tsc --noEmit -p runtime && tsc --noEmit -p app && tsc --noEmit -p app/tsconfig.test.json",
    "lint": "eslint . && prettier --check app packages runtime scripts eslint.config.js playwright.app.config.ts vitest.config.ts vitest.runtime.config.ts && node scripts/check-boundaries.mjs",
    "format": "prettier --write app packages runtime scripts eslint.config.js playwright.app.config.ts vitest.config.ts vitest.runtime.config.ts",
    "test": "vitest run",
    "test:product": "vitest run packages app/tests",
    "test:unit": "vitest run experiments/gate-a-electrical/tests",
    "test:e2e": "playwright test -c playwright.app.config.ts",
    "build:browser": "tsc -p experiments/gate-a-electrical/tsconfig.browser.json && cp experiments/gate-a-electrical/browser/index.html experiments/gate-a-electrical/dist-browser/browser/ && tsc -p experiments/gate-d-persistence/tsconfig.browser.json && cp experiments/gate-d-persistence/browser/index.html experiments/gate-d-persistence/dist-browser/browser/",
    "test:browser": "npm run build:browser && playwright test",
    "test:esp32": "vitest run --config vitest.esp32.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "host:build": "esbuild runtime/host/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=runtime/host/dist/session-host.mjs --log-level=warning",
    "buildsvc:build": "esbuild runtime/builder/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=runtime/builder/dist/build-service.mjs --log-level=warning && esbuild runtime/builder/build-job.ts --bundle --platform=node --format=esm --target=node22 --outfile=runtime/builder/dist/build-job.mjs --log-level=warning",
    "admin:build": "esbuild runtime/admin/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=runtime/admin/dist/admin-service.mjs --log-level=warning",
    "test:r2": "npm run host:build && vitest run --config vitest.runtime.config.ts runtime/tests/r2-",
    "test:r2:soak": "npm run host:build && vite-node runtime/soak/r2-soak.ts",
    "test:qemu-wasm": "TBI_QEMU_WASM=1 playwright test experiments/gate-b-esp32/browser/qemu-wasm.wasm.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eecircuit-engine": "^1.8.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "app",
    "packages/*"
  ]
}
