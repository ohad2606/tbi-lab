# TBI Lab runtime R1 — pinned inputs. Every artifact the runtime is built from is listed here.
# Sourced by provision.sh. Change a pin only with a report entry (docs/runtime/R1-REPORT.md).

# Maintained Espressif QEMU baseline: release esp-develop-9.2.2-20260417 (QEMU 9.2.2).
# The git commit id is itself the content pin (SHA-1 of the whole tree history); the fetch
# verifies it exactly.
QEMU_REPO=https://github.com/espressif/qemu.git
QEMU_TAG=esp-develop-9.2.2-20260417
QEMU_COMMIT=40edccac415693c5130f91c01d84176ae6008566

# Arduino CLI (checksum verified against the official release checksum file).
ARDUINO_CLI_VERSION=1.5.1
# sha256 of the release tarballs (GitHub release v1.5.1 asset digests; the same files are served
# from downloads.arduino.cc).
ARDUINO_CLI_SHA256_Linux_ARM64=1e69e077479f300614d4551334e0a33f08ee40b04315d83b8e7e0e94f0d0ee62
ARDUINO_CLI_SHA256_Linux_64bit=28a8e119c498a25607821c36cb2dc49e8463941b261a0d99091baa7bc692dd2b
# arduino-esp32 core; archives are checksum-verified by arduino-cli from the package index.
ARDUINO_ESP32_INDEX=https://espressif.github.io/arduino-esp32/package_esp32_index.json
ARDUINO_ESP32_VERSION=3.3.12
# Classic ESP32 only (Xtensa LX6). DIO: see R1-REPORT (QIO re-verified on the baseline).
# Fixed build timestamp for firmware (__DATE__/__TIME__ in the Arduino core): reproducible images.
FIRMWARE_SOURCE_DATE_EPOCH=1767225600  # 2026-01-01T00:00:00Z
ARDUINO_FQBN=esp32:esp32:esp32:FlashMode=dio

# MicroPython official release for the original ESP32 (independent firmware path).
MICROPYTHON_URL=https://micropython.org/resources/firmware/ESP32_GENERIC-20260824-v1.29.0.bin
MICROPYTHON_SHA256=e67ad6015a0a504c1fec9aa9bbf589d0432ed28e62546f4f8dd8a147f8bd95f6
