+/*
+ * One LEDC timer (P) or channel (W) state change from hw/misc/esp32_ledc.c, stamped with the virtual
+ * time it happened. Without a bridge nothing is published (the controller still keeps its registers).
+ */
+void tbi_bridge_pwm(char kind, int64_t vns, const char *body);
+void tbi_bridge_pwm(char kind, int64_t vns, const char *body)
+{
+    TbiBridge *s = tbi_bridge;
+    char frame[128];
+
+    if (!s) {
+        return;
+    }
+    snprintf(frame, sizeof(frame), "%c %" PRId64 " %s\n", kind, vns, body);
+    tbi_exchange(s, vns, frame, false);
+}
