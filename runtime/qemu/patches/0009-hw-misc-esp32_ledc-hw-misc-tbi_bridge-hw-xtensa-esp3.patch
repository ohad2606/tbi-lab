+/* The counter of timer t now (TIMER_VALUE): derived from virtual time, nothing is stepped. */
+static uint32_t ledc_counter(Esp32LEDCState *s, int t)
+{
+    uint32_t c = s->timer_conf_reg[t];
+    unsigned res = c & 0x1f;
+    uint32_t div = (c >> 5) & 0x3ffff;
+    uint32_t clk = (c & (1u << 25)) ? s->apb_freq : LEDC_REF_TICK_HZ;
+    int64_t dt = ledc_now() - s->timer_t0[t];
+
+    if ((c & (3u << 23)) || res < 1 || res > 20 || div < 256 || dt < 0) {
+        return 0;
+    }
+    uint64_t clocks = muldiv64((uint64_t)dt, clk, NANOSECONDS_PER_SECOND);
+    return (uint32_t)(muldiv64(clocks, 256, div) & ((1ull << res) - 1));
+}
