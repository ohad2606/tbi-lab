+/*
+ * TBI Lab (Sprint 12, ADR-011 §4; patch 0008). The controller executes its command list against
+ * the TBI host instead of QEMU-internal I2C devices: every bus phase (START or repeated START with
+ * the address byte, each written byte, each read byte, STOP) goes to tbi-bridge as a `B` frame and
+ * is answered synchronously from the circuit (hw/misc/tbi_bridge.c, tbi_bridge_i2c). Without a
+ * bridge nothing acknowledges and reads see the released bus (0xff).
+ *
+ * Changes to the upstream command semantics, each proven necessary by the Sprint 12 R3 probe or
+ * required by the PM decisions:
+ * - a NACKed data byte with ACK checking enabled (ACK_CHECK_EN, ACK_EXP = 0) raises ACK_ERR and
+ *   stops the command list, as for an address NACK (probe P-4; upstream ignored it);
+ * - RSTART is a repeated START: the transaction is not ended, the next written byte is an address;
+ * - bus timing (D-9): the command list's duration on the bus is computed from the timing
+ *   registers the driver programmed, in I2C module clock cycles (80 MHz APB_CLK, ESP32 TRM
+ *   "I2C Controller"): each byte is 9 SCL periods of SCL_LOW_PERIOD + SCL_HIGH_PERIOD cycles; a
+ *   (repeated) START adds RSTART_SETUP + START_HOLD and a STOP adds STOP_SETUP + STOP_HOLD.
+ *   ACK_ERR, TRANS_COMPLETE, END_DETECT and the commands' DONE bits are raised when that time
+ *   has elapsed, and the status register reports the bus busy until then. Not modelled: the
+ *   SCL filter and rise-time stretch the driver compensates for (a few cycles per bit), clock
+ *   stretching by targets and arbitration.
+ * Phases are reported to the host at the virtual time the command list starts.
+ */
+int tbi_bridge_i2c(int bus, char op, int arg);
+
+#define TBI_I2C_CLK_HZ 80000000ULL
+
+static void esp32_i2c_done(void *opaque)
+{
+    Esp32I2CState *s = Esp32_I2C(opaque);
+
+    s->busy = false;
+    s->int_raw_reg |= s->pending_int;
+    for (int i = 0; i < ESP32_I2C_CMD_COUNT; i++) {
+        if ((s->pending_done >> i) & 1) {
+            s->cmd_reg[i] = FIELD_DP32(s->cmd_reg[i], I2C_CMD, DONE, 1);
+        }
+    }
+    s->pending_int = 0;
+    s->pending_done = 0;
+    esp32_i2c_update_irq(s);
+}
+
 static void esp32_i2c_do_transaction(Esp32I2CState * s)
 {
     bool stop_or_end = false;
+    uint64_t cycles = 0;
+    uint64_t scl = (s->low_period_reg & 0x3fff) + (s->high_period_reg & 0x3fff);
+    uint32_t raw = 0;
+
+    if (s->busy) {
+        /* A new command list before the previous one finished: complete that one first. */
+        timer_del(s->done_timer);
+        esp32_i2c_done(s);
+    }
     for (int i_cmd = 0; i_cmd < ESP32_I2C_CMD_COUNT && !stop_or_end; ++i_cmd) {
         uint32_t cmd = s->cmd_reg[i_cmd];
         char opcode = FIELD_EX32(cmd, I2C_CMD, OPCODE);
+        bool check = FIELD_EX32(cmd, I2C_CMD, ACK_CHECK_EN) && FIELD_EX32(cmd, I2C_CMD, ACK_EXP) == 0;
         switch (opcode) {
             case I2C_OPCODE_RSTART:
-                i2c_end_transfer(s->bus);
+                /* (Repeated) START: the next written byte is the address. */
                 s->trans_ongoing = false;
+                cycles += (s->rstart_setup_reg & 0x3ff) + (s->start_hold_reg & 0x3ff);
                 break;
             case I2C_OPCODE_WRITE: {
                 size_t length = FIELD_EX32(cmd, I2C_CMD, BYTE_NUM);
-                if (!s->trans_ongoing) {
-                    s->trans_ongoing = true;
-                    uint8_t data = fifo8_pop(&s->tx_fifo);
-                    uint8_t addr = data >> 1;
-                    uint8_t is_read = data & 0x1;
-                    if (i2c_start_transfer(s->bus, addr, is_read) != 0) {
-                        /* NACK */
-                        if (FIELD_EX32(cmd, I2C_CMD, ACK_CHECK_EN)
-                            && FIELD_EX32(cmd, I2C_CMD, ACK_EXP) == 0) {
-                            s->int_raw_reg = FIELD_DP32(s->int_raw_reg, I2C_INT_RAW, ACK_ERR, 1);
-                            stop_or_end = true;
-                        }
-                        s->trans_ongoing = false;
+                for (size_t nbytes = 0; nbytes < length; ++nbytes) {
+                    uint8_t data = fifo8_is_empty(&s->tx_fifo) ? 0xff : fifo8_pop(&s->tx_fifo);
+                    int ack;
+                    if (!s->trans_ongoing) {
+                        s->trans_ongoing = true;
+                        ack = tbi_bridge_i2c(s->tbi_bus, 'S', data);
+                    } else {
+                        ack = tbi_bridge_i2c(s->tbi_bus, 'W', data);
+                    }
+                    cycles += 9 * scl;
+                    if (!ack && check) {
+                        raw = FIELD_DP32(raw, I2C_INT_RAW, ACK_ERR, 1);
+                        stop_or_end = true;
                         break;
                     }
-                    s->int_raw_reg = FIELD_DP32(s->int_raw_reg, I2C_INT_RAW, ACK_ERR, 0);
-                    length -= 1;
-                }
-                for (size_t nbytes = 0; nbytes < length; ++nbytes) {
-                    uint8_t data = fifo8_pop(&s->tx_fifo);
-                    i2c_send(s->bus, data);
                 }
                 break;
             }
             case I2C_OPCODE_READ: {
                 size_t length = FIELD_EX32(cmd, I2C_CMD, BYTE_NUM);
+                /* ACK_VAL is the level the controller drives in the ninth clock: 0 = ACK. */
+                int will_ack = FIELD_EX32(cmd, I2C_CMD, ACK_VAL) == 0;
                 for (size_t nbytes = 0; nbytes < length; ++nbytes) {
+                    uint8_t data = tbi_bridge_i2c(s->tbi_bus, 'R', will_ack);
+                    cycles += 9 * scl;
                     if (fifo8_num_free(&s->rx_fifo) == 0) {
                         error_report("esp32_i2c: RX FIFO overflow");
                     } else {
-                        uint8_t data = i2c_recv(s->bus);
                         fifo8_push(&s->rx_fifo, data);
                     }
                 }
                 break;
             }
             case I2C_OPCODE_STOP:
-                i2c_end_transfer(s->bus);
+                tbi_bridge_i2c(s->tbi_bus, 'P', 0);
                 s->trans_ongoing = false;
-                s->int_raw_reg = FIELD_DP32(s->int_raw_reg, I2C_INT_RAW, TRANS_COMPLETE, 1);
+                cycles += (s->stop_setup_reg & 0x3ff) + (s->stop_hold_reg & 0x3fff);
+                raw = FIELD_DP32(raw, I2C_INT_RAW, TRANS_COMPLETE, 1);
                 stop_or_end = true;
                 break;
             case I2C_OPCODE_END:
-                s->int_raw_reg = FIELD_DP32(s->int_raw_reg, I2C_INT_RAW, END_DETECT, 1);
+                raw = FIELD_DP32(raw, I2C_INT_RAW, END_DETECT, 1);
                 stop_or_end = true;
                 break;
             default:
                 error_report("esp32_i2c: Invalid command %d opcode %d", i_cmd, opcode);
                 break;
         }
-        s->cmd_reg[i_cmd] = FIELD_DP32(s->cmd_reg[i_cmd], I2C_CMD, DONE, 1);
+        s->pending_done |= 1u << i_cmd;
     }
-    esp32_i2c_update_irq(s);
+    s->pending_int |= raw;
+    s->busy = true;
+    timer_mod(s->done_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              (int64_t)(cycles * NANOSECONDS_PER_SECOND / TBI_I2C_CLK_HZ));
 }
 
 static const MemoryRegionOps esp32_i2c_ops = {
@@ -259,12 +321,20 @@ static void esp32_i2c_init(Object * obj)
 
     fifo8_create(&s->tx_fifo, ESP32_I2C_FIFO_LENGTH);
     fifo8_create(&s->rx_fifo, ESP32_I2C_FIFO_LENGTH);
+    s->done_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, esp32_i2c_done, s);
 }
 
+static Property esp32_i2c_properties[] = {
+    /* TBI Lab: the controller's index (0: I2C0, 1: I2C1), named in the B frames. */
+    DEFINE_PROP_UINT8("tbi-bus", Esp32I2CState, tbi_bus, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
