+/*
+ * One I2C bus phase from the ESP32 I2C controller (hw/i2c/esp32_i2c.c), answered synchronously by
+ * the host. op 'S': arg = address << 1 | R/W, returns 1 if acknowledged; 'W': arg = byte, returns
+ * 1 if acknowledged; 'R': arg = whether the controller will ACK, returns the byte; 'P': returns 0.
+ * Without a bridge there is no device on the bus: nothing acknowledges and a read sees the
+ * released bus (0xff). No device is ever invented here.
+ */
+int tbi_bridge_i2c(int bus, char op, int arg);
+int tbi_bridge_i2c(int bus, char op, int arg)
+{
+    TbiBridge *s = tbi_bridge;
+    int64_t now;
+    char frame[96];
+    int n;
+
+    if (!s) {
+        return op == 'R' ? 0xff : 0;
+    }
+    now = tbi_now();
+    n = snprintf(frame, sizeof(frame), "B %" PRId64 " %d ", now, bus);
+    switch (op) {
+    case 'S':
+        snprintf(frame + n, sizeof(frame) - n, "S %02x %d\n", (arg >> 1) & 0x7f, arg & 1);
+        s->bus_expect = 'K';
+        break;
+    case 'W':
+        snprintf(frame + n, sizeof(frame) - n, "W %02x\n", arg & 0xff);
+        s->bus_expect = 'K';
+        break;
+    case 'R':
+        snprintf(frame + n, sizeof(frame) - n, "R %d\n", arg ? 1 : 0);
+        s->bus_expect = 'D';
+        break;
+    default:
+        snprintf(frame + n, sizeof(frame) - n, "P\n");
+        s->bus_expect = 0;
+        break;
+    }
+    s->bus_got = 0;
+    s->bus_value = 0;
+    tbi_exchange(s, now, frame, false);
+    if (s->bus_got != (s->bus_expect ? 1 : 0)) {
+        tbi_fail(EXIT_PROTOCOL, "i2c phase answered without its K/D reply");
+    }
+    s->bus_expect = 0;
+    return s->bus_value;
+}
+
