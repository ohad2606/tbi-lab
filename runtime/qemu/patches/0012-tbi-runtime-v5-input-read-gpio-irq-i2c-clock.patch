@@ -62,6 +75,12 @@ static uint64_t esp32_gpio_drivers(Esp32GpioState *s)
 }
 
 #define TBI_A_GPIO_PIN0         0x88
+/* GPIO_PINn_REG fields (TRM v5.9 Register 6.30). */
+#define TBI_PIN_INT_TYPE(v)     (((v) >> 7) & 7)
+#define TBI_PIN_WAKEUP(v)       (((v) >> 10) & 1)
+#define TBI_PIN_INT_ENA(v)      (((v) >> 13) & 0x1f)
+#define TBI_INT_ENA_APP         0x01
+#define TBI_INT_ENA_PRO         0x04
 #define TBI_A_GPIO_FUNC0_OUT    0x530
 #define TBI_SIG_GPIO_OUT        256
 #define TBI_PAD_STATE_UNKNOWN   0xff
@@ -151,6 +170,72 @@ static uint64_t esp32_gpio_inputs(Esp32GpioState *s)
     return ((esp32_gpio_levels(s) & drivers) | (s->ext_in & ~drivers)) & PADS_EXIST;
 }
 
+void tbi_bridge_input_read(uint64_t pads);
+
+static uint32_t esp32_gpio_pin_reg(Esp32GpioState *s, int i)
+{
+    return s->regs[(TBI_A_GPIO_PIN0 + 4 * i) / 4];
+}
+
+static uint64_t esp32_gpio_status(Esp32GpioState *s)
+{
+    return ((uint64_t)s->status | ((uint64_t)(s->status1 & 0xff) << 32)) & PADS_EXIST;
+}
+
+/* (gpio-irq) The status bits enabled for one CPU's interrupt (TBI_INT_ENA_PRO or _APP). */
+static uint64_t esp32_gpio_cpu_int(Esp32GpioState *s, uint32_t ena)
+{
+    uint64_t st = esp32_gpio_status(s), m = 0;
+
+    for (int i = 0; i < ESP32_GPIO_PADS; i++) {
+        if ((st >> i) & 1 && TBI_PIN_INT_ENA(esp32_gpio_pin_reg(s, i)) & ena) {
+            m |= 1ULL << i;
+        }
+    }
+    return m;
+}
+
+/*
+ * (gpio-irq) Latch the edges since the last check into STATUS, then drive both CPU lines. Called
+ * after every change of an input level, an output, a pin configuration or the status.
+ */
+static void esp32_gpio_irq_update(Esp32GpioState *s)
+{
+    uint64_t in = esp32_gpio_inputs(s);
+    uint64_t changed = in ^ s->irq_last_in;
+
+    s->irq_last_in = in;
+    for (int i = 0; changed && i < ESP32_GPIO_PADS; i++) {
+        uint32_t pin = esp32_gpio_pin_reg(s, i);
+        uint32_t type = TBI_PIN_INT_TYPE(pin);
+        bool rising = (in >> i) & 1;
+
+        if (!((changed >> i) & 1) || !(TBI_PIN_INT_ENA(pin) & (TBI_INT_ENA_PRO | TBI_INT_ENA_APP))) {
+            continue;
+        }
+        if (type == 3 || (type == 1 && rising) || (type == 2 && !rising)) {
+            if (i < 32) {
+                s->status |= 1u << i;
+            } else {
+                s->status1 |= 1u << (i - 32);
+            }
+        }
+    }
+    qemu_set_irq(s->cpu_irq[ESP32_GPIO_IRQ_PRO], esp32_gpio_cpu_int(s, TBI_INT_ENA_PRO) != 0);
+    qemu_set_irq(s->cpu_irq[ESP32_GPIO_IRQ_APP], esp32_gpio_cpu_int(s, TBI_INT_ENA_APP) != 0);
+}
+
+/* (input-read) A read of the input register covering `bank`: report its undefined input pads. */
+static void esp32_gpio_report_undefined(Esp32GpioState *s, uint64_t bank)
+{
+    uint64_t u = s->undefined & ~esp32_gpio_drivers(s) & bank & PADS_EXIST & ~s->undefined_reported;
+
+    if (u) {
+        s->undefined_reported |= u;
+        tbi_bridge_input_read(u);
+    }
+}
+
 static uint64_t esp32_gpio_classic_read(Esp32GpioState *s, hwaddr addr)
 {
     switch (addr) {
@@ -165,13 +250,30 @@ static uint64_t esp32_gpio_classic_read(Esp32GpioState *s, hwaddr addr)
     case A_GPIO_STRAP:
         return s->strap_mode;
     case A_GPIO_IN:
+        esp32_gpio_report_undefined(s, 0xffffffffULL);
         return (uint32_t)esp32_gpio_inputs(s);
     case A_GPIO_IN1:
+        esp32_gpio_report_undefined(s, 0xff00000000ULL);
         return (uint32_t)(esp32_gpio_inputs(s) >> 32) & 0xff;
     case A_GPIO_STATUS:
         return s->status;
     case A_GPIO_STATUS1:
         return s->status1 & 0xff;
+    case A_GPIO_PCPU_INT:
+        return (uint32_t)esp32_gpio_cpu_int(s, TBI_INT_ENA_PRO);
+    case A_GPIO_ACPU_INT:
+        return (uint32_t)esp32_gpio_cpu_int(s, TBI_INT_ENA_APP);
+    case A_GPIO_PCPU_INT1:
+        return (uint32_t)(esp32_gpio_cpu_int(s, TBI_INT_ENA_PRO) >> 32) & 0xff;
+    case A_GPIO_ACPU_INT1:
+        return (uint32_t)(esp32_gpio_cpu_int(s, TBI_INT_ENA_APP) >> 32) & 0xff;
+    case A_GPIO_PCPU_NMI_INT:
+    case A_GPIO_ACPU_NMI_INT:
+    case A_GPIO_CPUSDIO_INT:
+    case A_GPIO_PCPU_NMI_INT1:
+    case A_GPIO_ACPU_NMI_INT1:
+    case A_GPIO_CPUSDIO_INT1:
+        return 0; /* NMI / SDIO enables are refused (unmodelled) */
     case A_GPIO_OUT_W1TS:
     case A_GPIO_OUT_W1TC:
     case A_GPIO_OUT1_W1TS:
@@ -237,38 +339,53 @@ static void esp32_gpio_classic_write(Esp32GpioState *s, hwaddr addr, uint32_t v)
         return; /* read-only */
     case A_GPIO_STATUS:
         s->status = v;
-        return;
+        break;
     case A_GPIO_STATUS_W1TS:
         s->status |= v;
-        return;
+        break;
     case A_GPIO_STATUS_W1TC:
         s->status &= ~v;
-        return;
+        break;
     case A_GPIO_STATUS1:
         s->status1 = v & 0xff;
-        return;
+        break;
     case A_GPIO_STATUS1_W1TS:
         s->status1 |= v & 0xff;
-        return;
+        break;
     case A_GPIO_STATUS1_W1TC:
         s->status1 &= ~v;
-        return;
+        break;
+    case A_GPIO_ACPU_INT:
+    case A_GPIO_ACPU_NMI_INT:
+    case A_GPIO_PCPU_INT:
+    case A_GPIO_PCPU_NMI_INT:
+    case A_GPIO_CPUSDIO_INT:
+    case A_GPIO_ACPU_INT1:
+    case A_GPIO_ACPU_NMI_INT1:
+    case A_GPIO_PCPU_INT1:
+    case A_GPIO_PCPU_NMI_INT1:
+    case A_GPIO_CPUSDIO_INT1:
+        return; /* read-only */
     default:
         s->regs[addr / 4] = v;
         if (addr >= TBI_A_GPIO_FUNC0_OUT && addr < TBI_A_GPIO_FUNC0_OUT + 4 * ESP32_GPIO_PADS) {
             s->out_sel_written |= 1ULL << ((addr - TBI_A_GPIO_FUNC0_OUT) / 4);
         } else if (!(addr >= TBI_A_GPIO_PIN0 && addr < TBI_A_GPIO_PIN0 + 4 * ESP32_GPIO_PADS)) {
             return;
-        } else if (((v >> 7) & 7) && ((v >> 13) & 0x1f)) {
+        } else if ((TBI_PIN_INT_TYPE(v) &&
+                    (TBI_PIN_INT_TYPE(v) > 3 || TBI_PIN_INT_ENA(v) & ~(TBI_INT_ENA_PRO | TBI_INT_ENA_APP)) &&
+                    TBI_PIN_INT_ENA(v)) || TBI_PIN_WAKEUP(v)) {
             /*
-             * TBI Lab (Runtime v4): GPIO_PINn with an interrupt type AND an interrupt enable: the
-             * guest enables a GPIO interrupt, which this emulator does not deliver (`unmodelled`).
+             * TBI Lab (Runtime v4, narrowed in v5): a GPIO interrupt this emulator does not
+             * deliver (level type, NMI or SDIO enable, wake-up enable) is `unmodelled`. Edge types
+             * on the PRO/APP CPU interrupt are delivered (gpio-irq).
              */
             tbi_bridge_unmodelled("gpio-interrupt");
         }
         break; /* functions, then pads, are published below */
     }
     esp32_gpio_update_pads(s);
+    esp32_gpio_irq_update(s);
 }
 
 static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
@@ -313,6 +430,25 @@ static void esp32_gpio_pad_in(void *opaque, int pad, int level)
     } else {
         s->ext_in &= ~(1ULL << pad);
     }
+    if (s->classic) {
+        esp32_gpio_irq_update(s);
+    }
+}
+
+/* (input-read) The host marks a pad's level as undefined (1) or defined again (0). */
+static void esp32_gpio_pad_undef(void *opaque, int pad, int undefined)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+
+    if (pad < 0 || pad >= ESP32_GPIO_PADS) {
+        return;
+    }
+    if (undefined) {
+        s->undefined |= 1ULL << pad;
+    } else {
+        s->undefined &= ~(1ULL << pad);
+        s->undefined_reported &= ~(1ULL << pad);
+    }
 }
 
 static const MemoryRegionOps uart_ops = {
@@ -335,6 +471,8 @@ static void esp32_gpio_reset_hold(Object *obj, ResetType type)
     memset(s->regs, 0, sizeof(s->regs));
     s->out_sel_written = 0;
     esp32_gpio_update_pads(s);
+    s->irq_last_in = esp32_gpio_inputs(s);
+    esp32_gpio_irq_update(s);
 }
 
 static void esp32_gpio_realize(DeviceState *dev, Error **errp)
@@ -359,6 +497,9 @@ static void esp32_gpio_init(Object *obj)
         s->pad_func[i] = TBI_SIG_GPIO_OUT;
     }
     qdev_init_gpio_in_named(DEVICE(obj), esp32_gpio_pad_in, ESP32_GPIO_PAD_IN, ESP32_GPIO_PADS);
+    qdev_init_gpio_in_named(DEVICE(obj), esp32_gpio_pad_undef, ESP32_GPIO_PAD_UNDEF,
+                            ESP32_GPIO_PADS);
+    qdev_init_gpio_out_named(DEVICE(obj), s->cpu_irq, ESP32_GPIO_IRQ_OUT, 2);
 }
 
