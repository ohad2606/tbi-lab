+/* TBI Lab (Runtime v5): a source signal of one CPU only (see percpu_level). */
+static void esp32_intmatrix_percpu_handler(void *opaque, int n, int level)
+{
+    Esp32IntMatrixState *s = ESP32_INTMATRIX(opaque);
+    int cpu = n / ESP32_INT_MATRIX_INPUTS;
+    int source = n % ESP32_INT_MATRIX_INPUTS;
+    qemu_irq line;
+
+    s->percpu_level[cpu][source] = level != 0;
+    line = esp32_intmatrix_line(s, cpu, IRQ_MAP(cpu, source));
+    if (line) {
+        qemu_set_irq(line, level);
+    }
