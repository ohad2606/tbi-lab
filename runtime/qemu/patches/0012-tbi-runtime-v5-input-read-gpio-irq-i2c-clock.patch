+/* The CPU interrupt line a map entry selects, or NULL (unmapped / not an external interrupt). */
+static qemu_irq esp32_intmatrix_line(Esp32IntMatrixState *s, int cpu, int out_index)
+{
+    if (s->outputs[cpu] == NULL) {
+        return NULL;
+    }
+    for (int int_index = 0; int_index < s->cpu[cpu]->env.config->nextint; ++int_index) {
+        if (s->cpu[cpu]->env.config->extint[int_index] == out_index) {
+            return s->outputs[cpu][int_index];
+        }
+    }
+    return NULL;
+}
