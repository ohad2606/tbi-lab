+/*
+ * (input-read, Runtime v5) The guest read an input register while `pads` (bit N = GPIO N), which
+ * the host marked undefined, were not driving (hw/gpio/esp32_gpio.c). Reported at the read itself;
+ * the host decides (it ends the session naming the pads). Without a bridge nothing is reported.
+ */
+void tbi_bridge_input_read(uint64_t pads);
+void tbi_bridge_input_read(uint64_t pads)
+{
+    TbiBridge *s = tbi_bridge;
+    int64_t now;
+    char frame[96];
+
+    if (!s) {
+        return;
+    }
+    now = tbi_now();
+    snprintf(frame, sizeof(frame), "N %" PRId64 " %010" PRIx64 "\n", now, pads);
+    tbi_exchange(s, now, frame, false);
+}
