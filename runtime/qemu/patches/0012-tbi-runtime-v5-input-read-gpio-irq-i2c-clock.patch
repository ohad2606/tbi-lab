diff --git a/hw/i2c/esp32_i2c.c b/hw/i2c/esp32_i2c.c
index ae964ed..d7b9447 100644
--- a/hw/i2c/esp32_i2c.c
+++ b/hw/i2c/esp32_i2c.c
@@ -7,6 +7,24 @@
 #include "hw/qdev-properties.h"
 #include "qemu/timer.h"
 
+/*
+ * TBI Lab (Runtime v5, i2c-clock): one SCL period in 80 MHz module clock cycles as the ESP32 TRM
+ * v5.9 Table 21.3-1 defines it: (SCL_LOW_PERIOD + 1) + SCL_HIGH_PERIOD + 7 without the SCL filter,
+ * + 8 with a filter threshold of 0..2, + 6 + threshold for 3..7. Rise time (which only lengthens
+ * the period) is not included: the frequency derived from it is an upper bound.
+ */
+static uint32_t esp32_i2c_scl_cycles(Esp32I2CState *s)
+{
+    uint32_t low = (s->low_period_reg & 0x3fff) + 1;
+    uint32_t high = s->high_period_reg & 0x3fff;
+    uint32_t thres = FIELD_EX32(s->scl_filter_cfg_reg, I2C_SCL_FILTER_CFG, THRES);
+
+    if (!FIELD_EX32(s->scl_filter_cfg_reg, I2C_SCL_FILTER_CFG, EN)) {
+        return low + high + 7;
+    }
+    return low + high + (thres <= 2 ? 8 : 6 + thres);
+}
+
 static void esp32_i2c_do_transaction(Esp32I2CState * s);
 static void esp32_i2c_update_irq(Esp32I2CState * s);
 
@@ -31,6 +49,7 @@ static void esp32_i2c_reset_hold(Object *obj, ResetType type)
     s->sda_sample_reg = 0;
     s->high_period_reg = 0;
     s->low_period_reg = 0;
+    s->scl_filter_cfg_reg = 0;
     s->start_hold_reg = 0;
     s->rstart_setup_reg = 0;
     s->stop_hold_reg = 0;
@@ -99,6 +118,8 @@ static uint64_t esp32_i2c_read(void * opaque, hwaddr addr, unsigned int size)
         return s->stop_hold_reg;
     case A_I2C_STOP_SETUP:
         return s->stop_setup_reg;
+    case A_I2C_SCL_FILTER_CFG:
+        return s->scl_filter_cfg_reg;
     default:
         return 0;
     }
@@ -175,6 +196,9 @@ static void esp32_i2c_write(void * opaque, hwaddr addr, uint64_t value, unsigned
     case A_I2C_STOP_SETUP:
         s->stop_setup_reg = value;
         break;
+    case A_I2C_SCL_FILTER_CFG:
+        s->scl_filter_cfg_reg = value;
+        break;
     default:
         break;
     }
@@ -251,7 +275,8 @@ static void esp32_i2c_do_transaction(Esp32I2CState * s)
                     int ack;
                     if (!s->trans_ongoing) {
                         s->trans_ongoing = true;
-                        ack = tbi_bridge_i2c(s->tbi_bus, 'S', data);
+                        /* (i2c-clock, Runtime v5) the programmed SCL period rides on the START. */
+                        ack = tbi_bridge_i2c(s->tbi_bus, 'S', esp32_i2c_scl_cycles(s) << 8 | data);
                     } else {
                         ack = tbi_bridge_i2c(s->tbi_bus, 'W', data);
                     }
