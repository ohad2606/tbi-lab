From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TBI Lab runtime <runtime@tbi-lab.local>
Date: Fri, 9 Oct 2026 15:00:00 +0000
Subject: [PATCH 7/8] hw/gpio/esp32_gpio, hw/misc/tbi_bridge: publish pad
 functions
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

TBI Lab (Sprint 12, ADR-011 §3). The classic ESP32 GPIO model now
publishes each pad's routed output function (GPIO_FUNCn_OUT_SEL, 256 =
simple GPIO) and open-drain bit (GPIO_PINn_PAD_DRIVER) on a new
"esp32-pad-func" line whenever they change. A pad routed to a peripheral
signal that can drive it (the peripheral controls the output enable, or
OEN_SEL selects GPIO_ENABLE and that bit is set; ESP-IDF leaves INPUT pins
at OUT_SEL 0 with OEN_SEL 1 and the enable clear) is driven by that
peripheral, so its "esp32-pad" line stays silent
until it is routed back to simple GPIO, when its state is published
again. An OUT_SEL the guest never wrote counts as simple GPIO; register
read-back is unchanged. An open-drain pad that outputs 1 is released, not
driving: only its 0 drives the net (the ESP-IDF I2C bus-clear routine
bit-bangs SCL this way).

tbi-bridge announces pad-func and forwards each change as
"F <vns> <pad> <func> <od>", with func gpio, i2c0-scl, i2c0-sda,
i2c1-scl, i2c1-sda (signal indices 29, 30, 95, 96 of ESP-IDF
soc/esp32/include/soc/gpio_sig_map.h) or periph:<signal>.

Signed-off-by: TBI Lab <runtime@tbi-lab.local>
---
 hw/gpio/esp32_gpio.c         | 84 +++++++++++++++++++++++++++++++++---
 hw/misc/tbi_bridge.c         | 43 +++++++++++++++++-
 include/hw/gpio/esp32_gpio.h |  8 ++++
 3 files changed, 128 insertions(+), 7 deletions(-)

diff --git a/hw/gpio/esp32_gpio.c b/hw/gpio/esp32_gpio.c
index 4db6569..6d362fd 100644
--- a/hw/gpio/esp32_gpio.c
+++ b/hw/gpio/esp32_gpio.c
@@ -22,9 +22,17 @@
  *   - a pad that is not driving is high impedance: GPIO_IN then reflects the externally applied
  *     level (the "esp32-pad-in" lines). A driving pad reads back its own output level;
  *   - every change of a pad's (drive, level) is published once, on its "esp32-pad" line.
+ *   - TBI Lab (Sprint 12, ADR-011 §3): each pad's routed output function (GPIO_FUNCn_OUT_SEL,
+ *     256 = simple GPIO) and open-drain bit (GPIO_PINn_PAD_DRIVER) are published on its
+ *     "esp32-pad-func" line whenever they change. A pad routed to a peripheral signal is driven by
+ *     that peripheral, not by GPIO_OUT/ENABLE, so its "esp32-pad" line stays silent until it is
+ *     routed back to simple GPIO (then its current state is published again). A FUNCn_OUT_SEL the
+ *     guest never wrote counts as simple GPIO; register read-back is unchanged. An open-drain
+ *     pad that outputs 1 is released (not driving): only its 0 drives the net.
  * Not modelled (documented runtime limitations): GPIO interrupts (STATUS bits are storage only),
- * the GPIO matrix routing of peripheral signals (FUNCn_IN/OUT_SEL are storage only), IO_MUX pad
- * functions, internal pull-ups/pull-downs, open-drain mode and drive strength.
+ * the GPIO matrix input routing (FUNCm_IN_SEL is storage only), IO_MUX pad functions, internal
+ * pull-ups/pull-downs and drive strength. Peripheral signals other than I2C carry no meaning for
+ * the TBI host (ADR-011 §3).
  */
 
 #include "qemu/osdep.h"
@@ -53,14 +61,68 @@ static uint64_t esp32_gpio_drivers(Esp32GpioState *s)
     return ((uint64_t)s->enable | ((uint64_t)(s->enable1 & 0xff) << 32)) & PADS_OUTPUT;
 }
 
-/* Publish every pad whose (drive, level) changed, in ascending pad order. */
+#define TBI_A_GPIO_PIN0         0x88
+#define TBI_A_GPIO_FUNC0_OUT    0x530
+#define TBI_SIG_GPIO_OUT        256
+#define TBI_PAD_STATE_UNKNOWN   0xff
+
+/*
+ * FUNCn_OUT_SEL | PAD_DRIVER << 9 of pad i (an unwritten OUT_SEL counts as simple GPIO). A routed
+ * peripheral signal owns the pad only if it can drive it: with OEN_SEL set the output enable comes
+ * from GPIO_ENABLE, and a pad whose GPIO_ENABLE bit is clear is an input whatever OUT_SEL holds
+ * (ESP-IDF configures INPUT pins exactly so: OUT_SEL 0, OEN_SEL 1, enable clear).
+ */
+static uint16_t esp32_gpio_func(Esp32GpioState *s, int i)
+{
+    uint32_t cfg = (s->out_sel_written >> i) & 1 ?
+        s->regs[(TBI_A_GPIO_FUNC0_OUT + 4 * i) / 4] : TBI_SIG_GPIO_OUT;
+    uint32_t sel = cfg & 0x1ff;
+    uint32_t od = (s->regs[(TBI_A_GPIO_PIN0 + 4 * i) / 4] >> 2) & 1;
+    if (sel != TBI_SIG_GPIO_OUT && (cfg >> 10) & 1 && !((esp32_gpio_drivers(s) >> i) & 1)) {
+        sel = TBI_SIG_GPIO_OUT;
+    }
+    return (uint16_t)(sel | od << 9);
+}
+
+/* Publish every pad whose routed function changed, in ascending pad order. */
+static void esp32_gpio_update_funcs(Esp32GpioState *s)
+{
+    for (int i = 0; i < ESP32_GPIO_PADS; i++) {
+        uint16_t f;
+        if (!((PADS_EXIST >> i) & 1)) {
+            continue;
+        }
+        f = esp32_gpio_func(s, i);
+        if (f == s->pad_func[i]) {
+            continue;
+        }
+        if ((f & 0x1ff) == TBI_SIG_GPIO_OUT && (s->pad_func[i] & 0x1ff) != TBI_SIG_GPIO_OUT) {
+            s->pad_state[i] = TBI_PAD_STATE_UNKNOWN; /* back to GPIO: publish its state again */
+        }
+        s->pad_func[i] = f;
+        qemu_set_irq(s->pad_func_out[i], f);
+    }
+}
+
+/* Publish every simple-GPIO pad whose (drive, level) changed, in ascending pad order. */
 static void esp32_gpio_update_pads(Esp32GpioState *s)
 {
-    uint64_t levels = esp32_gpio_levels(s);
-    uint64_t drivers = esp32_gpio_drivers(s);
+    uint64_t levels;
+    uint64_t drivers;
+
+    esp32_gpio_update_funcs(s); /* a function can depend on GPIO_ENABLE */
+    levels = esp32_gpio_levels(s);
+    drivers = esp32_gpio_drivers(s);
 
     for (int i = 0; i < ESP32_GPIO_PADS; i++) {
+        if ((s->pad_func[i] & 0x1ff) != TBI_SIG_GPIO_OUT) {
+            continue; /* driven by a peripheral */
+        }
         uint8_t drive = (drivers >> i) & 1;
+        /* Open drain (GPIO_PINn_PAD_DRIVER): a 1 releases the pad, only a 0 drives it. */
+        if (drive && ((s->pad_func[i] >> 9) & 1) && ((levels >> i) & 1)) {
+            drive = 0;
+        }
         uint8_t state = (drive << 1) | (drive ? ((levels >> i) & 1) : 0);
         if (state != s->pad_state[i]) {
             s->pad_state[i] = state;
@@ -178,7 +240,12 @@ static void esp32_gpio_classic_write(Esp32GpioState *s, hwaddr addr, uint32_t v)
         return;
     default:
         s->regs[addr / 4] = v;
-        return;
+        if (addr >= TBI_A_GPIO_FUNC0_OUT && addr < TBI_A_GPIO_FUNC0_OUT + 4 * ESP32_GPIO_PADS) {
+            s->out_sel_written |= 1ULL << ((addr - TBI_A_GPIO_FUNC0_OUT) / 4);
+        } else if (!(addr >= TBI_A_GPIO_PIN0 && addr < TBI_A_GPIO_PIN0 + 4 * ESP32_GPIO_PADS)) {
+            return;
+        }
+        break; /* functions, then pads, are published below */
     }
     esp32_gpio_update_pads(s);
 }
@@ -245,6 +312,7 @@ static void esp32_gpio_reset_hold(Object *obj, ResetType type)
     s->out = s->out1 = s->enable = s->enable1 = 0;
     s->status = s->status1 = 0;
     memset(s->regs, 0, sizeof(s->regs));
+    s->out_sel_written = 0;
     esp32_gpio_update_pads(s);
 }
 
@@ -265,6 +333,10 @@ static void esp32_gpio_init(Object *obj)
     sysbus_init_mmio(sbd, &s->iomem);
     sysbus_init_irq(sbd, &s->irq);
     qdev_init_gpio_out_named(DEVICE(obj), s->pad, ESP32_GPIO_PAD_OUT, ESP32_GPIO_PADS);
+    qdev_init_gpio_out_named(DEVICE(obj), s->pad_func_out, ESP32_GPIO_PAD_FUNC, ESP32_GPIO_PADS);
+    for (int i = 0; i < ESP32_GPIO_PADS; i++) {
+        s->pad_func[i] = TBI_SIG_GPIO_OUT;
+    }
     qdev_init_gpio_in_named(DEVICE(obj), esp32_gpio_pad_in, ESP32_GPIO_PAD_IN, ESP32_GPIO_PADS);
 }
 
diff --git a/hw/misc/tbi_bridge.c b/hw/misc/tbi_bridge.c
index 353eb1b..292f972 100644
--- a/hw/misc/tbi_bridge.c
+++ b/hw/misc/tbi_bridge.c
@@ -20,6 +20,9 @@
  *   G <vns> <pad> <drive> <level>       a pad's drive/level changed; host replies (commands...) C
  *   T <vns>                             periodic virtual-time tick; host replies (commands...) C
  *   S <vns> <hex>                       guest UART0 bytes (from chardev "tbi-serial"); no reply
+ *   F <vns> <pad> <func> <od>           (pad-func) a pad's routed function changed: gpio,
+ *                                       i2c0-scl, i2c0-sda, i2c1-scl, i2c1-sda or periph:<signal>;
+ *                                       <od> = open drain. Host replies (commands...) C
  * host -> QEMU, inside a reply:
  *   I <pad> <level>                     apply an external logic level to a pad (immediately)
  *   R <hex>                             queue bytes for the guest UART0 receiver (tick replies)
@@ -62,6 +65,7 @@
 #define TBI_GPIO_QOM_TYPE "esp32.gpio"
 #define TBI_PAD_OUT "esp32-pad"
 #define TBI_PAD_IN "esp32-pad-in"
+#define TBI_PAD_FUNC "esp32-pad-func"
 #define TBI_PADS 40
 
 #define TBI_LINE_MAX 1024
@@ -69,7 +73,7 @@
 #define TBI_RX_PENDING_MAX 4096
 
 /* Capability tokens this build implements, sorted (ADR-011 §1). */
-#define TBI_BRIDGE_CAPS "sched-input"
+#define TBI_BRIDGE_CAPS "pad-func,sched-input"
 #define TBI_SCHED_MAX 512
 #define TBI_SCHED_MIN_NS 1000
 
@@ -339,6 +343,40 @@ static void tbi_pad_changed(void *opaque, int pad, int state)
     tbi_exchange(s, now, frame, false);
 }
 
+/* A pad's routed function changed: FUNCn_OUT_SEL | open drain << 9, from hw/gpio/esp32_gpio.c. */
+static void tbi_pad_func(void *opaque, int pad, int value)
+{
+    TbiBridge *s = TBI_BRIDGE(opaque);
+    int64_t now = tbi_now();
+    int sel = value & 0x1ff;
+    char func[16];
+    char frame[96];
+
+    /* ESP-IDF soc/esp32/include/soc/gpio_sig_map.h: I2CEXT0 SCL 29, SDA 30; I2CEXT1 95, 96. */
+    switch (sel) {
+    case 256:
+        snprintf(func, sizeof(func), "gpio");
+        break;
+    case 29:
+        snprintf(func, sizeof(func), "i2c0-scl");
+        break;
+    case 30:
+        snprintf(func, sizeof(func), "i2c0-sda");
+        break;
+    case 95:
+        snprintf(func, sizeof(func), "i2c1-scl");
+        break;
+    case 96:
+        snprintf(func, sizeof(func), "i2c1-sda");
+        break;
+    default:
+        snprintf(func, sizeof(func), "periph:%d", sel);
+        break;
+    }
+    snprintf(frame, sizeof(frame), "F %" PRId64 " %d %s %d\n", now, pad, func, (value >> 9) & 1);
+    tbi_exchange(s, now, frame, false);
+}
+
 static void tbi_tick(void *opaque)
 {
     TbiBridge *s = TBI_BRIDGE(opaque);
@@ -425,8 +463,11 @@ static void tbi_bridge_realize(DeviceState *dev, Error **errp)
     tbi_bridge = s;
 
     qdev_init_gpio_in_named(dev, tbi_pad_changed, "pad", TBI_PADS);
+    qdev_init_gpio_in_named(dev, tbi_pad_func, "pad-func", TBI_PADS);
     for (int i = 0; i < TBI_PADS; i++) {
         qdev_connect_gpio_out_named(gpio, TBI_PAD_OUT, i, qdev_get_gpio_in_named(dev, "pad", i));
+        qdev_connect_gpio_out_named(gpio, TBI_PAD_FUNC, i,
+                                    qdev_get_gpio_in_named(dev, "pad-func", i));
         s->pad_in[i] = qdev_get_gpio_in_named(gpio, TBI_PAD_IN, i);
     }
 
diff --git a/include/hw/gpio/esp32_gpio.h b/include/hw/gpio/esp32_gpio.h
index 74d3f98..15a93eb 100644
--- a/include/hw/gpio/esp32_gpio.h
+++ b/include/hw/gpio/esp32_gpio.h
@@ -48,6 +48,7 @@ REG32(GPIO_STATUS1_W1TC, 0x0058)
  *   in  "esp32-pad-in" one line per pad; the externally applied logic level of the pad.
  */
 #define ESP32_GPIO_PAD_OUT "esp32-pad"
+#define ESP32_GPIO_PAD_FUNC "esp32-pad-func"
 #define ESP32_GPIO_PAD_IN  "esp32-pad-in"
 
 typedef struct Esp32GpioState {
@@ -72,6 +73,13 @@ typedef struct Esp32GpioState {
     uint8_t pad_state[ESP32_GPIO_PADS]; /* last (drive << 1 | level) reported per pad */
     uint32_t regs[0x1000 / 4];          /* plain storage for the other registers */
     qemu_irq pad[ESP32_GPIO_PADS];
+    /*
+     * TBI Lab (Sprint 12): each pad's routed function, published on "esp32-pad-func" whenever it
+     * changes: GPIO_FUNCn_OUT_SEL (256 = simple GPIO) | GPIO_PINn_PAD_DRIVER (open drain) << 9.
+     */
+    uint16_t pad_func[ESP32_GPIO_PADS];
+    uint64_t out_sel_written;           /* pads whose FUNCn_OUT_SEL the guest has written */
+    qemu_irq pad_func_out[ESP32_GPIO_PADS];
 } Esp32GpioState;
 
 typedef struct Esp32GpioClass {
