  "programs": {
    "U1": {
      "language": "micropython",
      "profile": "esp32-micropython-1.29",
      "fileName": "main.py",
      "text": "# TBI Lab example (MicroPython): a status display split over two files, using the managed library\n# python_lcd (MIT, Dave Hylands; pinned commit 7affb0b) for the LCD1602 I2C module. Nothing was\n# installed: placing the display made the library available to this project (in /lib).\n#\n# main.py    - opens the bus and shows the text\n# display.py - the display functions, with the library's I2cLcd (address 0x27, 2 x 16)\n#\n# Hardware I2C bus 0: SCL GPIO22, SDA GPIO21, 100 kHz (the PCF8574's rating). The library only\n# writes to the display.\nfrom machine import I2C, Pin\nimport display\n\ni2c = I2C(0, scl=Pin(22), sda=Pin(21), freq=100000)\nlcd = display.start(i2c)\ndisplay.show(lcd, \"TBI Lab\", \"MicroPython lib\")\nprint(\"LCD-LIB-READY\")\n",
      "libraries": [
        {
          "id": "micropython.python-lcd",
          "version": "0.0.0-git.7affb0b"
        }
      ],
      "files": [
        {
          "path": "display.py",
          "text": "# The display functions of the example, with the managed library's I2cLcd.\nfrom machine_i2c_lcd import I2cLcd\n\n\ndef start(i2c):\n    return I2cLcd(i2c, 0x27, 2, 16)\n\n\ndef show(lcd, line1, line2):\n    lcd.clear()\n    lcd.move_to(0, 0)\n    lcd.putstr(line1)\n    lcd.move_to(0, 1)\n    lcd.putstr(line2)\n"
        }
      ]
    }
  }
