  "programs": {
    "U1": {
      "language": "micropython",
      "profile": "esp32-micropython-1.29",
      "fileName": "main.py",
      "text": "# TBI Lab example (MicroPython): blink an LED.\n#\n# GPIO2 drives a red LED through a 220 ohm resistor to GND. Pin.OUT makes the pin a push-pull\n# output; value(1) drives it to 3.3 V, value(0) to 0 V. main.py runs once when the board starts,\n# so the loop is part of the program.\nfrom machine import Pin\nimport time\n\nled = Pin(2, Pin.OUT)\n\nwhile True:\n    led.value(1)\n    print(\"LED on\")\n    time.sleep_ms(500)\n    led.value(0)\n    print(\"LED off\")\n    time.sleep_ms(500)\n"
    }
  }
