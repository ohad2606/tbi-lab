+/* R4 PROBE (scratch only): trace every LEDC access with the virtual time. */
+#define R4P(kind, a, v) fprintf(stderr, "R4P %s %03x %08x %" PRId64 "\n", kind, (unsigned)(a), (unsigned)(v), qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL))
+
